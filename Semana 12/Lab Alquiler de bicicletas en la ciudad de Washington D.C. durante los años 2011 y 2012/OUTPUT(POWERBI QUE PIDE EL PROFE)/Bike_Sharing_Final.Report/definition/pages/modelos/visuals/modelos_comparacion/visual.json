                "Literal": {
                  "Value": "'import pandas as pd\nimport matplotlib.pyplot as plt\n\ndataset[\"DATE_TIME\"] = pd.to_datetime(dataset[\"DATE_TIME\"], errors=\"raise\")\ndataset = dataset.sort_values(\"DATE_TIME\")\nmodel_cols = [c for c in dataset.columns if c not in {\"DATE_TIME\", \"Usuarios\", \"ID_PREDICCION\"}]\nif len(model_cols) != 1:\n    raise ValueError(\"Se esperaba una predicción TEST seleccionada; columnas: {}\".format(model_cols))\nfig, ax = plt.subplots(figsize=(15, 6))\nax.plot(dataset[\"DATE_TIME\"], dataset[\"Usuarios\"], label=\"Real\")\nax.plot(dataset[\"DATE_TIME\"], dataset[model_cols[0]], label=\"Predicción seleccionada\")\nax.set(xlabel=\"Fecha y hora\", ylabel=\"Usuarios\")\nax.legend()\nplt.tight_layout()\nplt.show()'"
