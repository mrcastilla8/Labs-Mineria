          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import pandas as pd\nimport matplotlib.pyplot as plt\nfrom matplotlib.dates import AutoDateLocator, ConciseDateFormatter\n\nlabels = {\n    \"MODEL_FORECASTER\": \"Forecaster\",\n    \"MODEL_EXOGENEAS\": \"Exógenas\",\n    \"MODEL_EXOGENEAS_LGBM\": \"LightGBM\",\n    \"MODEL_EXOGENEAS_CatBoost\": \"CatBoost\",\n}\n\nfig, ax = plt.subplots(figsize=(11, 6), layout=\"constrained\")\nmodels = [name for name in dataset.columns if name != \"DATE_TIME\"]\nif dataset.empty or len(models) != 1:\n    ax.set_axis_off()\n    message = \"Sin pronóstico para el período seleccionado\" if dataset.empty else \"Selecciona un modelo en Forecasting\"\n    ax.text(0.5, 0.5, message, ha=\"center\", va=\"center\", color=\"#173C66\", transform=ax.transAxes)\nelse:\n    model = models[0]\n    dates = pd.to_datetime(dataset[\"DATE_TIME\"], errors=\"raise\")\n    values = pd.to_numeric(dataset[model], errors=\"raise\")\n    series = pd.Series(values.to_numpy(), index=dates).sort_index()\n    ax.plot(series.index, series, color=\"#1764AB\", linewidth=0.9, label=labels.get(model, model))\n    locator = AutoDateLocator(minticks=4, maxticks=8)\n    ax.xaxis.set_major_locator(locator)\n    ax.xaxis.set_major_formatter(ConciseDateFormatter(locator))\n    ax.set(xlabel=\"Fecha y hora\", ylabel=\"Alquileres pronosticados\")\n    ax.grid(axis=\"y\", alpha=0.23)\n    ax.spines[[\"top\", \"right\"]].set_visible(False)\n    ax.legend(loc=\"upper right\", frameon=False)\nplt.show()'"
                }
              }
